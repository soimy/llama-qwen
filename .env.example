MODEL_FILE=Qwen3.8-27B-UD-Q4_K_M.gguf
# 对外暴露的模型名（llama-server --alias）。外部 harness/客户端只需记这一个短名，
# 不必再填 /models/Qwen3.8-27B-UD-Q4_K_M.gguf 这类全路径。逗号分隔可挂多个别名。
MODEL_ALIAS=qwen3.8-27b
CTX_SIZE=131072
KV_TYPE=q4_0
NGPU_LAYERS=99
THREADS=12
OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=change-me-to-random
# llama.cpp server 的 API key（鉴权 llama:8080；Open WebUI 会自动带此 key 访问）
LLAMA_API_KEY=change-me-to-a-long-random-key
# 仅当模型仓库需授权时填写：
# HF_TOKEN=

# 第二模型（与主模型二选一运行）：orcarouter/Qwen3.8-27B-Uncensored-GGUF
# 3090 显存只够同时装一个 27B Q4，用 compose profile "uncensored" 隔离，make up-uncensored 单独启动（8081）
MODEL_FILE_UNCENSORED=Qwen3.8-27B-Uncensored-Q4_K_M.gguf
# 与主模型共用 qwen3.8-27b（24G 只能跑一个，切模型时 harness 配置无需改动），另加区分用的别名
MODEL_ALIAS_UNCENSORED=qwen3.8-27b,qwen3.8-27b-uncensored
MMPROJ_FILE_UNCENSORED=mmproj-Qwen3.8-27B-Uncensored-f16.gguf
CTX_SIZE_UNCENSORED=131072
KV_TYPE_UNCENSORED=q4_0
NGPU_LAYERS_UNCENSORED=99
THREADS_UNCENSORED=12
